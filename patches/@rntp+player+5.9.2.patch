@@ -0,0 +1,639 @@
+//
+//  SoundEffectTap.swift
+//  JKMUSIC 音效：把 Mac 端（Web Audio）的节点链挂到 AVPlayer 输出上
+//
+//  链路：EQ×10 → [dry / 卷积 wet] → 压缩器 → 3D 环绕 → 输出
+//  参数从 JS 下发（setSoundEffect），音频线程用 trylock 取快照，不阻塞、不分配内存。
+//
+
+import AVFoundation
+import MediaToolbox
+import os
+
+// MARK: - 配置
+
+struct SoundEffectConfig: Equatable {
+    var enabled: Bool = false
+    var eqGains: [Float] = Array(repeating: 0, count: 10)
+    var dryGain: Float = 1
+    var wetGain: Float = 0
+    var pannerEnabled: Bool = false
+    var pannerRadius: Float = 0.5
+    var pannerDegPerSec: Float = 20
+    /// 卷积混响的 IR 文件路径（空 = 不启用混响）
+    var irPath: String = ""
+    /// 变调倍率（1 = 不变）
+    var pitch: Float = 1
+
+    static let bypass = SoundEffectConfig()
+}
+
+/// 音频线程读取的不可变快照（含预先算好的滤波系数与卷积器）
+final class SoundEffectRuntime {
+    let enabled: Bool
+    let eqCoeffs: [BiquadCoeffs]
+    let eqActive: Bool
+    let dryGain: Float
+    let wetGain: Float
+    let pannerEnabled: Bool
+    let pannerRadius: Float
+    let pannerDegPerSec: Float
+    let reverb: ReverbConvolver?
+    let pitch: Float
+    let pitchActive: Bool
+    let sampleRate: Float
+
+    static let bypass = SoundEffectRuntime(config: .bypass, sampleRate: 44100, reverb: nil)
+
+    init(config: SoundEffectConfig, sampleRate: Float, reverb: ReverbConvolver?) {
+        enabled = config.enabled
+        dryGain = config.dryGain
+        wetGain = config.wetGain
+        pannerEnabled = config.pannerEnabled
+        pannerRadius = config.pannerRadius
+        pannerDegPerSec = config.pannerDegPerSec
+        self.reverb = reverb
+        self.sampleRate = sampleRate
+        pitch = config.pitch
+        pitchActive = abs(config.pitch - 1) > 0.001
+
+        let freqs: [Float] = [31, 62, 125, 250, 500, 1000, 2000, 4000, 8000, 16000]
+        var coeffs: [BiquadCoeffs] = []
+        coeffs.reserveCapacity(freqs.count)
+        var any = false
+        for (i, f) in freqs.enumerated() {
+            let g = i < config.eqGains.count ? config.eqGains[i] : 0
+            if g != 0 { any = true }
+            coeffs.append(BiquadCoeffs.peaking(freq: f, q: 1.4, gainDb: g, sampleRate: sampleRate))
+        }
+        eqCoeffs = coeffs
+        eqActive = any
+    }
+}
+
+// MARK: - 全局状态（主线程写，音频线程读）
+
+final class SoundEffectState {
+    static let shared = SoundEffectState()
+
+    private var lock = os_unfair_lock_s()
+    private var config: SoundEffectConfig = .bypass
+    private var runtime: SoundEffectRuntime = .bypass
+    private var sampleRate: Float = 44100
+
+    private init() {}
+
+    func update(_ newConfig: SoundEffectConfig, sampleRate: Float, reverb: ReverbConvolver?) {
+        os_unfair_lock_lock(&lock)
+        config = newConfig
+        if sampleRate > 0 { self.sampleRate = sampleRate }
+        runtime = SoundEffectRuntime(config: newConfig, sampleRate: self.sampleRate, reverb: reverb)
+        os_unfair_lock_unlock(&lock)
+    }
+
+    /// 音频线程：只有快照真的换了才返回 true
+    func tryRead(into out: inout SoundEffectRuntime, lastID: inout ObjectIdentifier?) -> Bool {
+        if !os_unfair_lock_trylock(&lock) { return false }
+        let r = runtime
+        os_unfair_lock_unlock(&lock)
+        let id = ObjectIdentifier(r)
+        if lastID == id { return false }
+        lastID = id
+        out = r
+        return true
+    }
+
+    var currentConfig: SoundEffectConfig {
+        os_unfair_lock_lock(&lock)
+        let c = config
+        os_unfair_lock_unlock(&lock)
+        return c
+    }
+
+    var currentSampleRate: Float {
+        os_unfair_lock_lock(&lock)
+        let s = sampleRate
+        os_unfair_lock_unlock(&lock)
+        return s
+    }
+}
+
+// MARK: - 单个 tap 的处理器（只跑在音频线程）
+
+final class SoundEffectProcessor {
+    private var runtime: SoundEffectRuntime = .bypass
+    private var runtimeID: ObjectIdentifier?
+    private var lastReverbID: ObjectIdentifier?
+    private var lastEnabled = false
+    private var sampleRate: Float = 44100
+    private var isFloat32 = true
+
+    // 10 段 EQ 的滤波器状态（左右各一份）
+    private var z1L = [Float](repeating: 0, count: 10)
+    private var z2L = [Float](repeating: 0, count: 10)
+    private var z1R = [Float](repeating: 0, count: 10)
+    private var z2R = [Float](repeating: 0, count: 10)
+
+    private let compressor = WebAudioCompressor()
+    private let vocoder = PhaseVocoder()
+    private var pannerAngle: Float = 0
+    private var lastPitchActive = false
+    private var hopOutL = [Float](repeating: 0, count: 128)
+    private var hopOutR = [Float](repeating: 0, count: 128)
+
+    private var interleavedScratch: [Float] = []
+
+    // 混响需要固定块长，用 FIFO 把任意帧数转成 1024 一块
+    private static let blockSize = 1024
+    private var inL: [Float] = []
+    private var inR: [Float] = []
+    private var outL: [Float] = []
+    private var outR: [Float] = []
+    private var convInL = [Float](repeating: 0, count: blockSize)
+    private var convInR = [Float](repeating: 0, count: blockSize)
+    private var convWetL = [Float](repeating: 0, count: blockSize)
+    private var convWetR = [Float](repeating: 0, count: blockSize)
+    private var blockL = [Float](repeating: 0, count: blockSize)
+    private var blockR = [Float](repeating: 0, count: blockSize)
+    private var blockActive = false
+
+    func prepare(sampleRate: Float, isFloat32: Bool) {
+        self.sampleRate = sampleRate
+        self.isFloat32 = isFloat32
+        compressor.prepare(sampleRate: sampleRate)
+        // 用真实采样率重建（保留当前混响；48k 音源会触发 IR 重采样）
+        SoundEffectTap.shared.refreshForSampleRate(sampleRate)
+        SoundEffectTap.shared.rebuildIfNeeded(sampleRate: sampleRate)
+        runtimeID = nil
+        resetFilters()
+        flushFIFO()
+    }
+
+    private func flushFIFO() {
+        inL.removeAll(keepingCapacity: true)
+        inR.removeAll(keepingCapacity: true)
+        outL.removeAll(keepingCapacity: true)
+        outR.removeAll(keepingCapacity: true)
+        blockActive = false
+    }
+
+    /// 离线渲染（整链对拍用）：与 tap 走完全相同的处理链
+    func renderOffline(
+        left: UnsafeMutablePointer<Float>,
+        right: UnsafeMutablePointer<Float>,
+        frames: Int,
+        runtime r: SoundEffectRuntime
+    ) {
+        runtime = r
+        runtimeID = nil
+        lastReverbID = r.reverb.map { ObjectIdentifier($0) }
+        lastEnabled = r.enabled
+        lastPitchActive = r.pitchActive
+        sampleRate = r.sampleRate
+        compressor.prepare(sampleRate: r.sampleRate)
+        resetFilters()
+        flushFIFO()
+        vocoder.reset()
+        vocoder.setPitch(r.pitch)
+        if needsPipeline {
+            processWithPipeline(left, right, frames: frames)
+        } else {
+            processInPlace(left, right, frames: frames)
+        }
+    }
+
+    func process(bufferList: UnsafeMutablePointer<AudioBufferList>, frames: Int, channels: Int) {
+        guard isFloat32, frames > 0 else { return }
+
+        if SoundEffectState.shared.tryRead(into: &runtime, lastID: &runtimeID) {
+            let reverbID = runtime.reverb.map { ObjectIdentifier($0) }
+            if reverbID != lastReverbID || runtime.enabled != lastEnabled || runtime.pitchActive != lastPitchActive {
+                resetFilters()
+                flushFIFO()
+                vocoder.reset()
+                lastReverbID = reverbID
+                lastEnabled = runtime.enabled
+                lastPitchActive = runtime.pitchActive
+            }
+            vocoder.setPitch(runtime.pitch)
+        }
+        guard runtime.enabled else { return }
+
+        let abl = UnsafeMutableAudioBufferListPointer(bufferList)
+        let nonInterleaved = abl.count >= 2
+
+        if nonInterleaved {
+            guard abl.count >= 2,
+                  let lPtr = abl[0].mData?.assumingMemoryBound(to: Float.self),
+                  let rPtr = abl[1].mData?.assumingMemoryBound(to: Float.self) else { return }
+            if needsPipeline {
+                processWithPipeline(lPtr, rPtr, frames: frames)
+            } else {
+                processInPlace(lPtr, rPtr, frames: frames)
+            }
+        } else if channels >= 2 {
+            guard let data = abl[0].mData?.assumingMemoryBound(to: Float.self) else { return }
+            if interleavedScratch.count < frames * 2 {
+                interleavedScratch = [Float](repeating: 0, count: frames * 2)
+            }
+            interleavedScratch.withUnsafeMutableBufferPointer { buf in
+                guard let base = buf.baseAddress else { return }
+                for i in 0..<frames {
+                    base[i] = data[i * 2]
+                    base[frames + i] = data[i * 2 + 1]
+                }
+                if needsPipeline {
+                    processWithPipeline(base, base + frames, frames: frames)
+                } else {
+                    processInPlace(base, base + frames, frames: frames)
+                }
+                for i in 0..<frames {
+                    data[i * 2] = base[i]
+                    data[i * 2 + 1] = base[frames + i]
+                }
+            }
+        }
+    }
+
+    private func resetFilters() {
+        for i in 0..<10 {
+            z1L[i] = 0; z2L[i] = 0; z1R[i] = 0; z2R[i] = 0
+        }
+    }
+
+    /// 无混响：原地处理
+    private func processInPlace(_ left: UnsafeMutablePointer<Float>, _ right: UnsafeMutablePointer<Float>, frames: Int) {
+        applyEQ(left, right, frames: frames)
+        let dry = runtime.dryGain
+        if dry != 1 {
+            for i in 0..<frames { left[i] *= dry; right[i] *= dry }
+        }
+        compressor.process(left, right, frames: frames)
+        applyPanner(left, right, frames: frames)
+    }
+
+    private var needsPipeline: Bool { runtime.reverb != nil || runtime.pitchActive }
+
+    /// 混响/变调：固定 1024 块，输入/输出各一个 FIFO
+    private func processWithPipeline(_ left: UnsafeMutablePointer<Float>, _ right: UnsafeMutablePointer<Float>, frames: Int) {
+        let reverb = runtime.reverb
+        for i in 0..<frames {
+            inL.append(left[i])
+            inR.append(right[i])
+        }
+
+        while inL.count >= SoundEffectProcessor.blockSize {
+            for i in 0..<SoundEffectProcessor.blockSize {
+                blockL[i] = inL[i]
+                blockR[i] = inR[i]
+                convInL[i] = inL[i]
+                convInR[i] = inR[i]
+            }
+            inL.removeFirst(SoundEffectProcessor.blockSize)
+            inR.removeFirst(SoundEffectProcessor.blockSize)
+
+            applyEQ(&blockL, &blockR, frames: SoundEffectProcessor.blockSize)
+
+            // 变调（相位声码器，128 样本一个 hop）
+            if runtime.pitchActive {
+                var h = 0
+                while h < SoundEffectProcessor.blockSize {
+                    blockL.withUnsafeBufferPointer { bl in
+                        blockR.withUnsafeBufferPointer { br in
+                            hopOutL.withUnsafeMutableBufferPointer { ol in
+                                hopOutR.withUnsafeMutableBufferPointer { orr in
+                                    vocoder.processHop(
+                                        inL: bl.baseAddress! + h,
+                                        inR: br.baseAddress! + h,
+                                        outL: ol.baseAddress!,
+                                        outR: orr.baseAddress!
+                                    )
+                                }
+                            }
+                        }
+                    }
+                    for i in 0..<128 {
+                        blockL[h + i] = hopOutL[i]
+                        blockR[h + i] = hopOutR[i]
+                    }
+                    h += 128
+                }
+            }
+
+            if let reverb {
+                for i in 0..<SoundEffectProcessor.blockSize {
+                    convInL[i] = blockL[i]
+                    convInR[i] = blockR[i]
+                }
+                convWetL.withUnsafeMutableBufferPointer { wl in
+                    convWetR.withUnsafeMutableBufferPointer { wr in
+                        convInL.withUnsafeBufferPointer { il in
+                            convInR.withUnsafeBufferPointer { ir in
+                                reverb.processBlock(il.baseAddress!, ir.baseAddress!,
+                                                    outL: wl.baseAddress!, outR: wr.baseAddress!)
+                            }
+                        }
+                    }
+                }
+            }
+
+            let dry = runtime.dryGain
+            let wet = reverb == nil ? 0 : runtime.wetGain
+            for i in 0..<SoundEffectProcessor.blockSize {
+                blockL[i] = blockL[i] * dry + convWetL[i] * wet
+                blockR[i] = blockR[i] * dry + convWetR[i] * wet
+            }
+            blockL.withUnsafeMutableBufferPointer { bl in
+                blockR.withUnsafeMutableBufferPointer { br in
+                    compressor.process(bl.baseAddress!, br.baseAddress!, frames: SoundEffectProcessor.blockSize)
+                    applyPanner(bl.baseAddress!, br.baseAddress!, frames: SoundEffectProcessor.blockSize)
+                }
+            }
+            outL.append(contentsOf: blockL)
+            outR.append(contentsOf: blockR)
+        }
+
+        let available = min(frames, outL.count)
+        for i in 0..<available {
+            left[i] = outL[i]
+            right[i] = outR[i]
+        }
+        if available < frames {
+            // 启动阶段不足一块：补静音
+            for i in available..<frames {
+                left[i] = 0
+                right[i] = 0
+            }
+        }
+        if available > 0 {
+            outL.removeFirst(available)
+            outR.removeFirst(available)
+        }
+    }
+
+    private func applyEQ(_ left: UnsafeMutablePointer<Float>, _ right: UnsafeMutablePointer<Float>, frames: Int) {
+        guard runtime.eqActive else { return }
+        let coeffs = runtime.eqCoeffs
+        for band in 0..<min(10, coeffs.count) {
+            let c = coeffs[band]
+            var zl1 = z1L[band], zl2 = z2L[band]
+            var zr1 = z1R[band], zr2 = z2R[band]
+            for i in 0..<frames {
+                let xl = left[i]
+                let yl = c.b0 * xl + zl1
+                zl1 = c.b1 * xl - c.a1 * yl + zl2
+                zl2 = c.b2 * xl - c.a2 * yl
+                left[i] = yl
+
+                let xr = right[i]
+                let yr = c.b0 * xr + zr1
+                zr1 = c.b1 * xr - c.a1 * yr + zr2
+                zr2 = c.b2 * xr - c.a2 * yr
+                right[i] = yr
+            }
+            z1L[band] = zl1; z2L[band] = zl2
+            z1R[band] = zr1; z2R[band] = zr2
+        }
+    }
+
+    private func applyPanner(_ left: UnsafeMutablePointer<Float>, _ right: UnsafeMutablePointer<Float>, frames: Int) {
+        guard runtime.pannerEnabled else { return }
+        let step = runtime.pannerDegPerSec * (32 / sampleRate)
+        var i = 0
+        while i < frames {
+            let n = min(32, frames - i)
+            let (gl, gr) = EqualPowerPanner.gains(angleDegrees: pannerAngle, radius: runtime.pannerRadius)
+            for k in 0..<n {
+                left[i + k] *= gl
+                right[i + k] *= gr
+            }
+            pannerAngle += step
+            if pannerAngle >= 360 { pannerAngle -= 360 }
+            i += n
+        }
+    }
+}
+
+// MARK: - Tap 管理
+
+final class SoundEffectTap {
+    static let shared = SoundEffectTap()
+
+    private weak var currentItem: AVPlayerItem?
+    private var currentReverb: ReverbConvolver?
+    private var lastIRPath: String = ""
+    private var irSampleRate: Float = 0
+    private var irToken = 0
+    private let irQueue = DispatchQueue(label: "jk.soundEffect.ir", qos: .userInitiated)
+
+    private init() {}
+
+    var isEnabled: Bool { SoundEffectState.shared.currentConfig.enabled }
+
+    /// JS 下发配置
+    func apply(_ dict: [String: Any]) {
+        var config = SoundEffectConfig()
+        config.enabled = dict["enabled"] as? Bool ?? false
+        if let eq = dict["eq"] as? [NSNumber], eq.count == 10 {
+            config.eqGains = eq.map { $0.floatValue }
+        }
+        config.dryGain = (dict["dryGain"] as? NSNumber)?.floatValue ?? 1
+        config.wetGain = (dict["wetGain"] as? NSNumber)?.floatValue ?? 0
+        config.pannerEnabled = dict["pannerEnabled"] as? Bool ?? false
+        config.pannerRadius = (dict["pannerRadius"] as? NSNumber)?.floatValue ?? 0.5
+        config.pannerDegPerSec = (dict["pannerDegPerSec"] as? NSNumber)?.floatValue ?? 20
+        config.irPath = dict["irPath"] as? String ?? ""
+        config.pitch = (dict["pitch"] as? NSNumber)?.floatValue ?? 1
+
+        let rate = SoundEffectState.shared.currentSampleRate
+        SoundEffectState.shared.update(config, sampleRate: rate, reverb: currentReverb)
+        NSLog("[soundEffect] apply enabled=\(config.enabled) dry=\(config.dryGain) wet=\(config.wetGain) ir=\(config.irPath.split(separator: "/").last ?? "")")
+
+        if config.enabled {
+            if let item = currentItem {
+                attach(to: item)
+            }
+        } else {
+            currentItem?.audioMix = nil
+        }
+
+        if config.irPath != lastIRPath {
+            lastIRPath = config.irPath
+            currentReverb = nil
+            SoundEffectState.shared.update(config, sampleRate: rate, reverb: nil)
+            if !config.irPath.isEmpty {
+                loadReverb(path: config.irPath, sampleRate: rate)
+            }
+        }
+    }
+
+    /// 用真实采样率刷新运行时（保留当前混响实例）
+    func refreshForSampleRate(_ sampleRate: Float) {
+        SoundEffectState.shared.update(
+            SoundEffectState.shared.currentConfig,
+            sampleRate: sampleRate,
+            reverb: currentReverb
+        )
+    }
+
+    /// 采样率变化（切到 48k 音源）时按新采样率重建 IR
+    func rebuildIfNeeded(sampleRate: Float) {
+        guard !lastIRPath.isEmpty, abs(sampleRate - irSampleRate) > 1 else { return }
+        loadReverb(path: lastIRPath, sampleRate: sampleRate)
+    }
+
+    private func loadReverb(path: String, sampleRate: Float) {
+        irToken += 1
+        let token = irToken
+        irSampleRate = sampleRate
+        irQueue.async { [weak self] in
+            guard let self else { return }
+            do {
+                // JS 给的是 file:// URL；直接 URL(fileURLWithPath:) 会把 "file://" 当成路径前缀
+                let url: URL
+                if let u = URL(string: path), u.isFileURL {
+                    url = u
+                } else {
+                    url = URL(fileURLWithPath: path)
+                }
+                let channels = try ReverbIRLoader.load(
+                    url: url,
+                    targetSampleRate: Double(sampleRate)
+                )
+                let kernel = ReverbKernel(channels: channels, sampleRate: sampleRate)
+                let conv = ReverbConvolver(kernel: kernel)
+                DispatchQueue.main.async {
+                    guard token == self.irToken else { return }
+                    self.currentReverb = conv
+                    SoundEffectState.shared.update(
+                        SoundEffectState.shared.currentConfig,
+                        sampleRate: sampleRate,
+                        reverb: conv
+                    )
+                    NSLog("[soundEffect] reverb ready ch=\(channels.count) sr=\(sampleRate) parts=\(kernel.partitions)")
+                }
+            } catch {
+                NSLog("[soundEffect] reverb load failed: \(error)")
+            }
+        }
+    }
+
+    /// item 安装时调用：记住当前 item，启用时挂 audioMix
+    func attach(to item: AVPlayerItem) {
+        currentItem = item
+        guard isEnabled, item.audioMix == nil else { return }
+
+        item.asset.loadTracks(withMediaType: .audio) { [weak self, weak item] tracks, error in
+            guard let self, let item, let track = tracks?.first else {
+                NSLog("[soundEffect] no audio track: \(String(describing: error))")
+                return
+            }
+            DispatchQueue.main.async {
+                guard SoundEffectState.shared.currentConfig.enabled,
+                      self.currentItem === item else { return }
+                if let mix = self.makeMix(for: track) {
+                    item.audioMix = mix
+                    NSLog("[soundEffect] audioMix attached")
+                }
+            }
+        }
+    }
+
+    private func makeMix(for track: AVAssetTrack) -> AVAudioMix? {
+        let processor = SoundEffectProcessor()
+        let clientInfo = Unmanaged.passRetained(processor).toOpaque()
+
+        var callbacks = MTAudioProcessingTapCallbacks(
+            version: kMTAudioProcessingTapCallbacksVersion_0,
+            clientInfo: clientInfo,
+            init: tapInit,
+            finalize: tapFinalize,
+            prepare: tapPrepare,
+            unprepare: tapUnprepare,
+            process: tapProcess
+        )
+
+        var tap: MTAudioProcessingTap?
+        let status = MTAudioProcessingTapCreate(
+            kCFAllocatorDefault,
+            &callbacks,
+            kMTAudioProcessingTapCreationFlag_PostEffects,
+            &tap
+        )
+        guard status == noErr, let tap else {
+            Unmanaged<SoundEffectProcessor>.fromOpaque(clientInfo).release()
+            NSLog("[soundEffect] MTAudioProcessingTapCreate failed: \(status)")
+            return nil
+        }
+
+        let params = AVMutableAudioMixInputParameters(track: track)
+        params.audioTapProcessor = tap
+        let mix = AVMutableAudioMix()
+        mix.inputParameters = [params]
+        return mix
+    }
+}
+
+// MARK: - C 回调
+
+private func tapInit(
+    tap: MTAudioProcessingTap,
+    clientInfo: UnsafeMutableRawPointer?,
+    tapStorageOut: UnsafeMutablePointer<UnsafeMutableRawPointer?>
+) {
+    tapStorageOut.pointee = clientInfo
+}
+
+private func tapFinalize(tap: MTAudioProcessingTap) {
+    let storage = MTAudioProcessingTapGetStorage(tap)
+    Unmanaged<SoundEffectProcessor>.fromOpaque(storage).release()
+    NSLog("[soundEffect] tap finalize")
+}
+
+private func tapPrepare(
+    tap: MTAudioProcessingTap,
+    maxFrames: CMItemCount,
+    processingFormat: UnsafePointer<AudioStreamBasicDescription>
+) {
+    let fmt = processingFormat.pointee
+    let storage = MTAudioProcessingTapGetStorage(tap)
+    let processor = Unmanaged<SoundEffectProcessor>.fromOpaque(storage).takeUnretainedValue()
+
+    let isFloat = (fmt.mFormatFlags & kAudioFormatFlagIsFloat) != 0
+    processor.prepare(sampleRate: Float(fmt.mSampleRate), isFloat32: isFloat && fmt.mBitsPerChannel == 32)
+    NSLog("[soundEffect] tap prepare frames=\(maxFrames) sr=\(fmt.mSampleRate) ch=\(fmt.mChannelsPerFrame)")
+}
+
+private func tapUnprepare(tap: MTAudioProcessingTap) {
+    NSLog("[soundEffect] tap unprepare")
+}
+
+private func tapProcess(
+    tap: MTAudioProcessingTap,
+    numberFrames: CMItemCount,
+    flags: MTAudioProcessingTapFlags,
+    bufferListInOut: UnsafeMutablePointer<AudioBufferList>,
+    numberFramesOut: UnsafeMutablePointer<CMItemCount>,
+    flagsOut: UnsafeMutablePointer<MTAudioProcessingTapFlags>
+) {
+    let status = MTAudioProcessingTapGetSourceAudio(
+        tap,
+        numberFrames,
+        bufferListInOut,
+        flagsOut,
+        nil,
+        numberFramesOut
+    )
+    guard status == noErr else { return }
+
+    let storage = MTAudioProcessingTapGetStorage(tap)
+    let processor = Unmanaged<SoundEffectProcessor>.fromOpaque(storage).takeUnretainedValue()
+
+    let abl = UnsafeMutableAudioBufferListPointer(bufferListInOut)
+    let channels = abl.count >= 2 ? abl.count : (abl.count == 1 ? Int(abl[0].mNumberChannels) : 0)
+    processor.process(
+        bufferList: bufferListInOut,
+        frames: Int(numberFramesOut.pointee),
+        channels: channels
+    )
+}
