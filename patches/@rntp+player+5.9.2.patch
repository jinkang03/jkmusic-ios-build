diff --git a/node_modules/@rntp/player/ios/player/PhaseVocoder.swift b/node_modules/@rntp/player/ios/player/PhaseVocoder.swift
new file mode 100644
index 0000000..bbb73e2
--- /dev/null
+++ b/node_modules/@rntp/player/ios/player/PhaseVocoder.swift
@@ -0,0 +1,217 @@
+//
+//  PhaseVocoder.swift
+//  JKMUSIC 音效：与 Mac 端（olvb/phaze）一致的相位声码器变调
+//
+//  Mac 参数：blockSize 4096 / hop 128 / 32 重叠 / Hann 窗 0.8*(1-cos)
+//  算法：Hann 分析窗 → FFT → 峰值检测 → 按 pitchFactor 搬移峰值区域（带相位修正）
+//        → 强制共轭对称 → IFFT → Hann 合成窗 → 重叠相加（÷32）
+//
+
+import Accelerate
+import Foundation
+
+final class PhaseVocoder {
+    static let fftSize = 4096
+    static let hop = 128
+    static let overlaps = 32
+    private static let log2n: vDSP_Length = 12
+    private static let binCount = fftSize / 2 + 1 // 2049
+
+    private let setup: FFTSetup
+    private let window: [Float]
+
+    // 每个声道一套状态
+    private var inputL: [Float]
+    private var inputR: [Float]
+    private var outputL: [Float]
+    private var outputR: [Float]
+
+    // 频谱/时域临时缓冲（左右各一份，避免在音频线程分配）
+    private var re = [Float](repeating: 0, count: PhaseVocoder.fftSize)
+    private var im = [Float](repeating: 0, count: PhaseVocoder.fftSize)
+    private var sRe = [Float](repeating: 0, count: PhaseVocoder.fftSize)
+    private var sIm = [Float](repeating: 0, count: PhaseVocoder.fftSize)
+    private var mags = [Float](repeating: 0, count: PhaseVocoder.binCount)
+    private var peaks = [Int](repeating: 0, count: PhaseVocoder.binCount)
+
+    private var timeCursor: Float = 0
+    private var pitchFactor: Float = 1
+
+    init() {
+        setup = vDSP_create_fftsetup(PhaseVocoder.log2n, FFTRadix(kFFTRadix2))!
+        var w = [Float](repeating: 0, count: PhaseVocoder.fftSize)
+        for i in 0..<PhaseVocoder.fftSize {
+            w[i] = 0.8 * (1 - cosf(2 * Float.pi * Float(i) / Float(PhaseVocoder.fftSize)))
+        }
+        window = w
+        inputL = [Float](repeating: 0, count: PhaseVocoder.fftSize + PhaseVocoder.hop)
+        inputR = [Float](repeating: 0, count: PhaseVocoder.fftSize + PhaseVocoder.hop)
+        outputL = [Float](repeating: 0, count: PhaseVocoder.fftSize)
+        outputR = [Float](repeating: 0, count: PhaseVocoder.fftSize)
+    }
+
+    deinit {
+        vDSP_destroy_fftsetup(setup)
+    }
+
+    func setPitch(_ factor: Float) {
+        let clamped = min(1.5, max(0.5, factor))
+        if clamped != pitchFactor {
+            pitchFactor = clamped
+        }
+    }
+
+    func reset() {
+        for i in inputL.indices { inputL[i] = 0 }
+        for i in inputR.indices { inputR[i] = 0 }
+        for i in outputL.indices { outputL[i] = 0 }
+        for i in outputR.indices { outputR[i] = 0 }
+        timeCursor = 0
+    }
+
+    /// 处理一个 hop（128 样本），输出同样 128 样本
+    func processHop(
+        inL: UnsafePointer<Float>,
+        inR: UnsafePointer<Float>,
+        outL: UnsafeMutablePointer<Float>,
+        outR: UnsafeMutablePointer<Float>
+    ) {
+        // 与 phaze 的 OLA 一致：新样本放到末尾，然后整体左移一个 hop
+        let n = PhaseVocoder.fftSize
+        let hop = PhaseVocoder.hop
+        for i in 0..<hop {
+            inputL[n + i] = inL[i]
+            inputR[n + i] = inR[i]
+        }
+        for i in 0..<n {
+            inputL[i] = inputL[i + hop]
+            inputR[i] = inputR[i + hop]
+        }
+
+        processChannel(&inputL, output: &outputL)
+        processChannel(&inputR, output: &outputR)
+
+        for i in 0..<hop {
+            outL[i] = outputL[i]
+            outR[i] = outputR[i]
+        }
+        // 输出左移一个 hop，尾部清零
+        for i in 0..<(n - hop) {
+            outputL[i] = outputL[i + hop]
+            outputR[i] = outputR[i + hop]
+        }
+        for i in (n - hop)..<n {
+            outputL[i] = 0
+            outputR[i] = 0
+        }
+
+        timeCursor += Float(hop)
+    }
+
+    private func processChannel(_ input: inout [Float], output: inout [Float]) {
+        let n = PhaseVocoder.fftSize
+        let bins = PhaseVocoder.binCount
+
+        // 分析窗
+        for i in 0..<n {
+            re[i] = input[i] * window[i]
+            im[i] = 0
+        }
+
+        // 正变换
+        re.withUnsafeMutableBufferPointer { rp in
+            im.withUnsafeMutableBufferPointer { ip in
+                var split = DSPSplitComplex(realp: rp.baseAddress!, imagp: ip.baseAddress!)
+                vDSP_fft_zip(setup, &split, 1, PhaseVocoder.log2n, FFTDirection(FFT_FORWARD))
+            }
+        }
+
+        // 幅度
+        for i in 0..<bins {
+            mags[i] = re[i] * re[i] + im[i] * im[i]
+        }
+
+        // 峰值
+        var nbPeaks = 0
+        var i = 2
+        let end = bins - 2
+        while i < end {
+            let m = mags[i]
+            if mags[i - 1] >= m || mags[i - 2] >= m {
+                i += 1
+                continue
+            }
+            if mags[i + 1] >= m || mags[i + 2] >= m {
+                i += 1
+                continue
+            }
+            peaks[nbPeaks] = i
+            nbPeaks += 1
+            i += 2
+        }
+
+        // 搬移峰值区域
+        for k in 0..<n { sRe[k] = 0; sIm[k] = 0 }
+        if pitchFactor != 1 {
+            let factor = pitchFactor
+            for p in 0..<nbPeaks {
+                let peakIndex = peaks[p]
+                let peakShifted = Int((Float(peakIndex) * factor).rounded())
+                if peakShifted > bins { break }
+
+                var startIndex = 0
+                var endIndex = n
+                if p > 0 {
+                    startIndex = peakIndex - (peakIndex - peaks[p - 1]) / 2
+                }
+                if p < nbPeaks - 1 {
+                    endIndex = peakIndex + (peaks[p + 1] - peakIndex + 1) / 2
+                }
+
+                let startOffset = startIndex - peakIndex
+                let endOffset = endIndex - peakIndex
+                var j = startOffset
+                while j < endOffset {
+                    let binIndex = peakIndex + j
+                    let binShifted = peakShifted + j
+                    if binShifted >= bins { break }
+                    if binIndex >= 0 && binIndex < n && binShifted >= 0 {
+                        let omegaDelta = 2 * Float.pi * Float(binShifted - binIndex) / Float(n)
+                        let phase = omegaDelta * timeCursor
+                        let pr = cosf(phase)
+                        let pi = sinf(phase)
+                        let vr = re[binIndex]
+                        let vi = im[binIndex]
+                        sRe[binShifted] += vr * pr - vi * pi
+                        sIm[binShifted] += vr * pi + vi * pr
+                    }
+                    j += 1
+                }
+            }
+        } else {
+            for k in 0..<n { sRe[k] = re[k]; sIm[k] = im[k] }
+        }
+
+        // 强制共轭对称（与 fft.js completeSpectrum 等价：正半轴镜像到负半轴）
+        var k = 1
+        while k < n / 2 {
+            sRe[n - k] = sRe[k]
+            sIm[n - k] = -sIm[k]
+            k += 1
+        }
+
+        // 逆变换
+        sRe.withUnsafeMutableBufferPointer { rp in
+            sIm.withUnsafeMutableBufferPointer { ip in
+                var split = DSPSplitComplex(realp: rp.baseAddress!, imagp: ip.baseAddress!)
+                vDSP_fft_zip(setup, &split, 1, PhaseVocoder.log2n, FFTDirection(FFT_INVERSE))
+            }
+        }
+
+        // 合成窗 + 重叠相加（÷32）
+        let scale = 1 / (Float(n) * Float(PhaseVocoder.overlaps))
+        for idx in 0..<n {
+            output[idx] += sRe[idx] * window[idx] * scale
+        }
+    }
+}
