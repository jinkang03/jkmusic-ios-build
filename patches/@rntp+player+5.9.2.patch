+//
+//  SoundEffectDSP.swift
+//  JKMUSIC 音效：与 Mac 端（Web Audio）对齐的 DSP 组件
+//
+//  - Biquad: RBJ peaking（与 Chrome 同一套系数公式，Q=1.4）
+//  - Compressor: WebKit DynamicsCompressorKernel 的移植（默认参数）
+//  - Panner: Web Audio equalpower + inverse 距离衰减
+//
+
+import Foundation
+
+// MARK: - Biquad
+
+struct BiquadCoeffs {
+    var b0: Float = 1
+    var b1: Float = 0
+    var b2: Float = 0
+    var a1: Float = 0
+    var a2: Float = 0
+
+    static let pass = BiquadCoeffs()
+
+    /// RBJ peaking EQ，与 Web Audio `BiquadFilterNode` 的 peaking 一致
+    static func peaking(freq: Float, q: Float, gainDb: Float, sampleRate: Float) -> BiquadCoeffs {
+        guard sampleRate > 0, freq > 0, freq < sampleRate / 2, gainDb != 0 else { return .pass }
+        let a = powf(10, gainDb / 40)
+        let w0 = 2 * Float.pi * freq / sampleRate
+        let alpha = sinf(w0) / (2 * q)
+        let cosw = cosf(w0)
+
+        let b0 = 1 + alpha * a
+        let b1 = -2 * cosw
+        let b2 = 1 - alpha * a
+        let a0 = 1 + alpha / a
+        let a1 = -2 * cosw
+        let a2 = 1 - alpha / a
+
+        return BiquadCoeffs(
+            b0: b0 / a0,
+            b1: b1 / a0,
+            b2: b2 / a0,
+            a1: a1 / a0,
+            a2: a2 / a0
+        )
+    }
+}
+
+// MARK: - Compressor（WebKit 移植）
+
+final class WebAudioCompressor {
+    private static let maxPreDelayFrames = 1024
+    private static let maxPreDelayFramesMask = 1023
+    private static let defaultPreDelayFrames = 256
+    private static let divisionFrames = 32
+
+    // 固定参数（Web Audio 默认值）
+    private let dbThreshold: Float = -24
+    private let dbKnee: Float = 30
+    private let ratio: Float = 12
+    private let attackTime: Float = 0.003
+    private let releaseTime: Float = 0.25
+    private let preDelayTime: Float = 0.006
+    private let dbPostGain: Float = 0
+    private let releaseZone1: Float = 0.09
+    private let releaseZone2: Float = 0.16
+    private let releaseZone3: Float = 0.42
+    private let releaseZone4: Float = 0.98
+
+    private var sampleRate: Float = 44100
+    private var preDelayBuffers: [[Float]] = [
+        [Float](repeating: 0, count: maxPreDelayFrames),
+        [Float](repeating: 0, count: maxPreDelayFrames),
+    ]
+    private var preDelayReadIndex = 0
+    private var preDelayWriteIndex = defaultPreDelayFrames
+    private var lastPreDelayFrames = defaultPreDelayFrames
+
+    private var detectorAverage: Float = 0
+    private var compressorGain: Float = 1
+    private var maxAttackCompressionDiffDb: Float = -1
+
+    // 静态曲线
+    private var linearThreshold: Float = 0
+    private var kneeThreshold: Float = 0
+    private var kneeThresholdDb: Float = 0
+    private var ykneeThresholdDb: Float = 0
+    private var slope: Float = 0
+    private var kValue: Float = 1
+    private var staticReady = false
+
+    private var kA: Float = 0
+    private var kB: Float = 0
+    private var kC: Float = 0
+    private var kD: Float = 0
+    private var kE: Float = 0
+
+    func prepare(sampleRate: Float) {
+        guard sampleRate > 0 else { return }
+        self.sampleRate = sampleRate
+        updateStaticCurve()
+        buildReleaseCurve()
+        reset()
+    }
+
+    func reset() {
+        detectorAverage = 0
+        compressorGain = 1
+        maxAttackCompressionDiffDb = -1
+        for i in preDelayBuffers.indices {
+            for j in preDelayBuffers[i].indices { preDelayBuffers[i][j] = 0 }
+        }
+        preDelayReadIndex = 0
+        preDelayWriteIndex = WebAudioCompressor.defaultPreDelayFrames
+    }
+
+    private func linearToDb(_ x: Float) -> Float { 20 * log10f(max(x, 1e-9)) }
+    private func dbToLinear(_ x: Float) -> Float { powf(10, x / 20) }
+
+    private func kneeCurve(_ x: Float, _ k: Float) -> Float {
+        if x < linearThreshold { return x }
+        return linearThreshold + (1 - expf(-k * (x - linearThreshold))) / k
+    }
+
+    private func saturate(_ x: Float, _ k: Float) -> Float {
+        if x < kneeThreshold { return kneeCurve(x, k) }
+        let xDb = linearToDb(x)
+        let yDb = ykneeThresholdDb + slope * (xDb - kneeThresholdDb)
+        return dbToLinear(yDb)
+    }
+
+    private func slopeAt(_ x: Float, _ k: Float) -> Float {
+        if x < linearThreshold { return 1 }
+        let x2 = x * 1.001
+        let xDb = linearToDb(x)
+        let x2Db = linearToDb(x2)
+        let yDb = linearToDb(kneeCurve(x, k))
+        let y2Db = linearToDb(kneeCurve(x2, k))
+        return (y2Db - yDb) / (x2Db - xDb)
+    }
+
+    private func kAtSlope(_ desiredSlope: Float) -> Float {
+        let x = dbToLinear(dbThreshold + dbKnee)
+        var minK: Float = 0.1
+        var maxK: Float = 10000
+        var k: Float = 5
+        for _ in 0..<15 {
+            let s = slopeAt(x, k)
+            if s < desiredSlope { maxK = k } else { minK = k }
+            k = sqrtf(minK * maxK)
+        }
+        return k
+    }
+
+    private func updateStaticCurve() {
+        guard !staticReady else { return }
+        staticReady = true
+        linearThreshold = dbToLinear(dbThreshold)
+        slope = 1 / ratio
+        let k = kAtSlope(slope)
+        kneeThresholdDb = dbThreshold + dbKnee
+        kneeThreshold = dbToLinear(kneeThresholdDb)
+        ykneeThresholdDb = linearToDb(kneeCurve(kneeThreshold, k))
+        kValue = k
+    }
+
+    private func buildReleaseCurve() {
+        let releaseFrames = sampleRate * releaseTime
+        let y1 = releaseFrames * releaseZone1
+        let y2 = releaseFrames * releaseZone2
+        let y3 = releaseFrames * releaseZone3
+        let y4 = releaseFrames * releaseZone4
+
+        kA = 0.9999999999999998 * y1 + 1.8432219684323923e-16 * y2 - 1.9373394351676423e-16 * y3 + 8.824516011816245e-18 * y4
+        kB = -1.5788320352845888 * y1 + 2.3305837032074286 * y2 - 0.9141194204840429 * y3 + 0.1623677525612032 * y4
+        kC = 0.5334142869106424 * y1 - 1.272736789213631 * y2 + 0.9258856042207512 * y3 - 0.18656310191776226 * y4
+        kD = 0.08783463138207234 * y1 - 0.1694162967925622 * y2 + 0.08588057951595272 * y3 - 0.00429891410546283 * y4
+        kE = -0.042416883008123074 * y1 + 0.1115693827987602 * y2 - 0.09764676325265872 * y3 + 0.028494263462021576 * y4
+    }
+
+    private func setPreDelayTime(_ time: Float) {
+        var frames = UInt32(time * sampleRate)
+        if frames > UInt32(WebAudioCompressor.maxPreDelayFrames - 1) {
+            frames = UInt32(WebAudioCompressor.maxPreDelayFrames - 1)
+        }
+        if lastPreDelayFrames != Int(frames) {
+            lastPreDelayFrames = Int(frames)
+            for i in preDelayBuffers.indices {
+                for j in preDelayBuffers[i].indices { preDelayBuffers[i][j] = 0 }
+            }
+            preDelayReadIndex = 0
+            preDelayWriteIndex = Int(frames)
+        }
+    }
+
+    /// 原地处理两个声道
+    func process(_ left: UnsafeMutablePointer<Float>, _ right: UnsafeMutablePointer<Float>, frames: Int) {
+        guard frames > 0 else { return }
+        updateStaticCurve()
+        setPreDelayTime(preDelayTime)
+
+        let fullRangeGain = saturate(1, kValue)
+        var fullRangeMakeupGain = 1 / max(fullRangeGain, 1e-6)
+        fullRangeMakeupGain = powf(fullRangeMakeupGain, 0.6)
+        let masterLinearGain = dbToLinear(dbPostGain) * fullRangeMakeupGain
+
+        let attackFrames = max(0.001, attackTime) * sampleRate
+        let satReleaseFrames = 0.0025 * sampleRate
+
+        var frameIndex = 0
+        let mask = WebAudioCompressor.maxPreDelayFramesMask
+
+        while frameIndex < frames {
+            // 每个 division 重新算一次包络速率
+            if detectorAverage.isNaN { detectorAverage = 1 }
+            if detectorAverage.isInfinite { detectorAverage = 1 }
+
+            let desiredGain = detectorAverage
+            let scaledDesiredGain = asinf(min(1, max(-1, desiredGain))) / (0.5 * Float.pi)
+
+            var envelopeRate: Float
+            let isReleasing = scaledDesiredGain > compressorGain
+            var compressionDiffDb = linearToDb(compressorGain / max(scaledDesiredGain, 1e-6))
+
+            if isReleasing {
+                if compressionDiffDb.isNaN || compressionDiffDb.isInfinite { compressionDiffDb = -1 }
+                var x = max(-12, min(0, compressionDiffDb))
+                x = 0.25 * (x + 12)
+                let x2 = x * x
+                let x3 = x2 * x
+                let x4 = x2 * x2
+                let releaseFrames = kA + kB * x + kC * x2 + kD * x3 + kE * x4
+                let dbPerFrame = 5 / max(releaseFrames, 1)
+                envelopeRate = dbToLinear(dbPerFrame)
+            } else {
+                if compressionDiffDb.isNaN || compressionDiffDb.isInfinite { compressionDiffDb = 1 }
+                if maxAttackCompressionDiffDb == -1 || maxAttackCompressionDiffDb < compressionDiffDb {
+                    maxAttackCompressionDiffDb = compressionDiffDb
+                }
+                let effAttenDiffDb = max(0.5, maxAttackCompressionDiffDb)
+                let x = 0.25 / effAttenDiffDb
+                envelopeRate = 1 - powf(x, 1 / attackFrames)
+            }
+
+            var detector = detectorAverage
+            var gain = compressorGain
+            var readIndex = preDelayReadIndex
+            var writeIndex = preDelayWriteIndex
+
+            let loopFrames = min(WebAudioCompressor.divisionFrames, frames - frameIndex)
+            for _ in 0..<loopFrames {
+                let l = left[frameIndex]
+                let r = right[frameIndex]
+                preDelayBuffers[0][writeIndex] = l
+                preDelayBuffers[1][writeIndex] = r
+
+                let absL = abs(l)
+                let absR = abs(r)
+                let compressorInput = max(absL, absR)
+                let absInput = abs(compressorInput)
+
+                let shapedInput = saturate(absInput, kValue)
+                let attenuation: Float = absInput <= 0.0001 ? 1 : shapedInput / absInput
+
+                var attenuationDb = -linearToDb(attenuation)
+                attenuationDb = max(2, attenuationDb)
+                let satReleaseRate = dbToLinear(attenuationDb / satReleaseFrames) - 1
+
+                let isRelease = attenuation > detector
+                let rate: Float = isRelease ? satReleaseRate : 1
+                detector += (attenuation - detector) * rate
+                detector = min(1, detector)
+                if detector.isNaN || detector.isInfinite { detector = 1 }
+
+                if envelopeRate < 1 {
+                    gain += (scaledDesiredGain - gain) * envelopeRate
+                } else {
+                    gain *= envelopeRate
+                    gain = min(1, gain)
+                }
+
+                let postWarp = sinf(0.5 * Float.pi * gain)
+                let totalGain = masterLinearGain * postWarp
+
+                left[frameIndex] = preDelayBuffers[0][readIndex] * totalGain
+                right[frameIndex] = preDelayBuffers[1][readIndex] * totalGain
+
+                frameIndex += 1
+                readIndex = (readIndex + 1) & mask
+                writeIndex = (writeIndex + 1) & mask
+            }
+
+            preDelayReadIndex = readIndex
+            preDelayWriteIndex = writeIndex
+            detectorAverage = detector
+            compressorGain = gain
+        }
+    }
+}
+
+// MARK: - Panner（equalpower + inverse 距离衰减）
+
+struct EqualPowerPanner {
+    /// 按 Mac 端的公式算出左右增益
+    static func gains(angleDegrees: Float, radius: Float) -> (Float, Float) {
+        let rad = angleDegrees * Float.pi / 180
+        let x = sinf(rad) * radius
+        let y = cosf(rad) * radius
+        let z = cosf(rad) * radius
+
+        let distance = sqrtf(x * x + y * y + z * z)
+        let azimuth = atan2f(x, -z) * 180 / Float.pi
+
+        var pan = (azimuth + 90) / 180
+        pan = min(1, max(0, pan))
+        let a = pan * Float.pi / 2
+        let gainL = cosf(a)
+        let gainR = sinf(a)
+
+        // inverse 距离模型：refDistance=1, rolloff=1
+        let distGain: Float = distance <= 1 ? 1 : 1 / (1 + (distance - 1))
+        return (gainL * distGain, gainR * distGain)
+    }
+}
